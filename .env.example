# General
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
DATA_MODE=real
ALLOW_SYNTHETIC_DEMOS=true
ALLOW_DEV_AUTH=true

# Database (Compose service hostname, not localhost, from containers)
POSTGRES_DB=khulna_salt_intrusion
POSTGRES_USER=swot_app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://swot_app:change-me-local-only@db:5432/khulna_salt_intrusion

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Hydrocron
HYDROCRON_BASE_URL=https://soto.podaac.earthdatacloud.nasa.gov/hydrocron/v1/timeseries
HYDROCRON_API_KEY=
HYDROCRON_TIMEOUT_SECONDS=20
HYDROCRON_CACHE_SECONDS=900
HYDROCRON_MAX_RANGE_DAYS=2500

# NASA Earthdata (PO.DAAC / SWOT)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus CDS (ERA5 Meteorological Covariates)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# Auth: generate secure random secrets for real use
AUTH_ISSUER=swot-khulna-local
AUTH_AUDIENCE=swot-khulna-api
JWT_SECRET=local-only-replace-with-long-random-secret
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage
DATA_DIR=/app/data
ARTIFACT_DIR=/app/artifacts
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Model compute/limits
ML_DEVICE=auto
MAX_TRAINING_ROWS=200000
MAX_TRAINING_MINUTES=30
MAX_CONCURRENT_EXPERIMENTS=1

# Browser CORS / URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SWOT Khulna
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
